 "integrity": {
  "no_question_specific_answers": "the harness has no question-to-answer mapping; every answer is generated by the model from tool outputs (answer_source=model or model_after_validation_retry)",
  "harness_fallback": "if the model's answer fails validation twice, or the risk gate holds back an unverified candidate, the harness returns a generic ANALYSIS_UNSAFE / INVESTIGATE notice; such answers are labelled answer_source=harness_fallback in the trace and are never presented as model output",
  "numbers": "every number in an accepted answer must appear in a tool output (harness/validate.py)"
 }
